# Neon connection string for async SQLAlchemy + asyncpg.
# asyncpg uses `ssl=require`; libpq's `sslmode=require` is not accepted.
# For Neon's pooled endpoint, append `&prepared_statement_cache_size=0`
# or use the direct (non-pooler) host.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Google AI Studio key, used only for structure detection.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

MAX_UPLOAD_MB=10
APP_ENV=development
